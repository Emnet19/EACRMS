{
    "$schema": "https://opencode.ai/config.json",
    "provider": {
        "agentrouter": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "AgentRouter",
            "options": {
                "baseURL": "https://agentrouter.org/v1"
            },
            "models": {
                "glm-5.3": {
                    "name": "GLM 5.3",
                    "reasoning": true,
                    "limit": {
                        "context": 128000,
                        "output": 16384
                    }
                }
            }
        }
    }
}